# Install as /etc/default/ariadne-routing and keep it root-owned.
ARIADNE_ROUTING_IFACE=enp1s0
ARIADNE_ROUTING_LAN_IP=192.168.1.10
ARIADNE_ROUTING_GATEWAY=192.168.1.1
ARIADNE_ROUTING_LAN_CIDR=192.168.1.0/24

# Optional values shown with their defaults.
ARIADNE_ROUTING_TABLE=1061
ARIADNE_NODE_PORT=14771
ARIADNE_QUIC_RULE_PREF=10065
ARIADNE_WSS_RULE_PREF=10066
