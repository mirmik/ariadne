# Local development defaults. Use HTTPS for a public node plane.
ARIADNE_MANAGEMENT_RELAY=http://127.0.0.1:8088
# Optional override. Relay creates the default user config token file on first start.
ARIADNE_MANAGEMENT_TOKEN_FILE=
ARIADNE_NODE_RELAY=http://127.0.0.1:14771
# Optional: use breakglass@relay-host instead of a directly reachable node port.
ARIADNE_NODE_RELAY_SSH=
# Optional pre-provisioned SHA-256 pin; otherwise first TLS use requires PAKE pairing.
ARIADNE_NODE_RELAY_CERT_PIN=
ARIADNE_NODE_RELAY_FALLBACK=auto
ARIADNE_MANAGEMENT_LISTEN=127.0.0.1:8088
ARIADNE_NODE_LISTEN=127.0.0.1:14771
# Public deployment may set LAN listeners and keep the SSH tunnel endpoint separate.
ARIADNE_NODE_LOOPBACK_LISTEN=
ARIADNE_NODE_QUIC_LISTEN=
ARIADNE_NODE_TLS_CERT=
ARIADNE_NODE_TLS_KEY=
ARIADNE_ALIAS=phone
